{
  "about": "Whether a lease holds its tab, run by rooms (test/leases.test.mjs) and perch (test/room.test.mjs). last and start are ms relative to now; pid \"alive\" or \"dead\" stands for a running or exited process; start is when that pid's process started, null when ps can't say.",
  "cases": [
    { "name": "active mid-call", "lease": { "owner": "x", "pid": "alive", "last": -60000, "active": true, "stuck": null }, "start": -120000, "held": true },
    { "name": "inactive past five seconds", "lease": { "owner": "x", "pid": "alive", "last": -8000, "active": false, "stuck": null }, "start": -120000, "held": false },
    { "name": "inactive within five seconds", "lease": { "owner": "x", "pid": "alive", "last": -2000, "active": false, "stuck": null }, "start": -120000, "held": true },
    { "name": "dead pid", "lease": { "owner": "x", "pid": "dead", "last": 0, "active": true, "stuck": null }, "start": null, "held": false },
    { "name": "pid reused after the last call", "lease": { "owner": "x", "pid": "alive", "last": -60000, "active": true, "stuck": null }, "start": -10000, "held": false },
    { "name": "pid started within a second of the last call", "lease": { "owner": "x", "pid": "alive", "last": -60000, "active": true, "stuck": null }, "start": -59000, "held": true },
    { "name": "start unknown", "lease": { "owner": "x", "pid": "alive", "last": -3600000, "active": true, "stuck": null }, "start": null, "held": true },
    { "name": "inactive within five seconds skips the reuse check", "lease": { "owner": "x", "pid": "alive", "last": -3000, "active": false, "stuck": null }, "start": -1000, "held": true },
    { "name": "user lease", "lease": { "owner": "user", "pid": "alive", "last": -600000, "active": true, "stuck": null, "since": "2026-01-01T00:00:00.000Z" }, "start": -700000, "held": true },
    { "name": "ownerless stuck lease", "lease": { "last": -1000, "active": false, "stuck": { "type": "key", "event": { "key": "Shift" } } }, "start": null, "held": false },
    { "name": "missing last and active", "lease": { "owner": "x", "pid": "alive" }, "start": -120000, "held": false },
    { "name": "missing pid", "lease": { "owner": "x", "last": 0, "active": true, "stuck": null }, "start": null, "held": false },
    { "name": "pid not a number", "lease": { "owner": "x", "pid": "1234", "last": 0, "active": true, "stuck": null }, "start": null, "held": false }
  ]
}
